name = "horizon"
compatibility_date = "2026-07-27"
pages_build_output_dir = "public"

[[d1_databases]]
binding = "NOWAI_DB"
database_name = "nowai-admin"
database_id = "将这里替换为 Cloudflare D1 Database ID"
migrations_dir = "migrations"

# 请使用 Secrets 设置，不要把真实值写入本文件或提交到 Git：
#   wrangler pages secret put ANALYTICS_SALT
#   wrangler pages secret put ADMIN_PASSWORD
